{
  "name": "client-portal",
  "version": "1.0.0",
  "description": "Client Portal - 顧客専用ページ・ファイル受け渡し・確認承認",
  "scripts": {
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/src/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backup": "node dist/scripts/backup.js",
    "restore": "node dist/scripts/restore.js",
    "create-operator": "node dist/scripts/create-operator.js",
    "demo": "npm run build:web && tsx scripts/demo.ts",
    "gc-orphans": "node dist/scripts/gc-orphans.js",
    "loadtest": "tsx scripts/loadtest.ts",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/lib-storage": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "nodemailer": "^10.0.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "s3rver": "^3.7.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
