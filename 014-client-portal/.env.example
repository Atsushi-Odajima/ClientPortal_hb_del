# ==== 必須 ====
# 公開URL（招待リンク・Origin検証に使用）
PUBLIC_URL=https://portal.example.com
# 32文字以上のランダム文字列（例: openssl rand -hex 32）
SESSION_SECRET=
# 初回セットアップ時に入力するトークン（公開直後の乗っ取り防止）。セットアップ後は削除可
SETUP_TOKEN=
# docker-compose の Caddy 用ドメイン
DOMAIN=portal.example.com

# ==== 任意 ====
ALLOW_SIGNUP=false
# ファイル保存先: local（既定）または s3
STORAGE_DRIVER=local
# S3互換（Cloudflare R2 の例）
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=client-portal
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
SIGNED_URL_SECONDS=300

# メール: none（既定・招待リンクは手動で送付）/ smtp
MAIL_DRIVER=none
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Client Portal <no-reply@example.com>

# 上限（将来変更可能な設定）
MAX_UPLOAD_MB=500
CHUNK_MB=8
MAX_PROJECT_STORAGE_MB=0
MAX_ACTIVE_PROJECTS=0
MAX_ZIP_MB=4096
INVITE_DEFAULT_DAYS=14
INVITE_MAX_DAYS=90
CLIENT_SESSION_DAYS=30
OPERATOR_SESSION_DAYS=14
